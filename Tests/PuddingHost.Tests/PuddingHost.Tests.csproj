<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PuddingHost.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\PuddingHost\PuddingHost.csproj" />
    <!-- D8 契约连通门禁：链接 Desktop 侧无 UI 的合同适配器源码作为真实生产者（不引用 Shell）。 -->
    <ProjectReference Include="..\..\Source\Pudding.Contracts\Pudding.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Source\PuddingDesktop.WpfArchive\Browser\BrowserBridgeCommandAdapter.cs"
             Link="BrowserBridgeContract\BrowserBridgeCommandAdapter.cs" />
    <Compile Include="..\..\Source\PuddingDesktop.WpfArchive\Browser\BrowserBridgeResultAdapter.cs"
             Link="BrowserBridgeContract\BrowserBridgeResultAdapter.cs" />
    <Compile Include="..\..\Source\PuddingDesktop.WpfArchive\Browser\BrowserBridgeExecutorRoute.cs"
             Link="BrowserBridgeContract\BrowserBridgeExecutorRoute.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      声明式 host package 清单必须与产品输出同构：HostToolContributions 从
      AppContext.BaseDirectory/tools/host-packages 读 exports，非 Kernel 工具只能经它暴露。
      这条规则与 Source/PuddingHost/Build/PuddingHostContent.props 的 host-packages 行
      保持同一目标路径；该 props 整体不导入测试工程——它还带 worker 项目引用与前端资产复制。
    -->
    <Content Include="..\..\Source\PuddingHost\ToolPackages\*.json"
             Link="tools/host-packages/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
