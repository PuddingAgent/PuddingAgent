{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PuddingDesktop",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "pudding-build-desktop",
            "program": "${workspaceFolder}/Source/PuddingDesktop/bin/Debug/net10.0-windows10.0.17763.0/PuddingDesktop.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "PUDDING_DESKTOP_HOME": "${env:LOCALAPPDATA}/Pudding",
                "PUDDING_REPOSITORY_ROOT": "${workspaceFolder}"
            },
            "console": "internalConsole",
            "stopAtEntry": false,
            "justMyCode": true
        },
        {
            "name": "PuddingDesktop (后台启动)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "pudding-build-desktop",
            "program": "${workspaceFolder}/Source/PuddingDesktop/bin/Debug/net10.0-windows10.0.17763.0/PuddingDesktop.dll",
            "args": ["--background"],
            "cwd": "${workspaceFolder}",
            "env": {
                "PUDDING_DESKTOP_HOME": "${env:LOCALAPPDATA}/Pudding",
                "PUDDING_REPOSITORY_ROOT": "${workspaceFolder}"
            },
            "console": "internalConsole",
            "stopAtEntry": false,
            "justMyCode": true
        },
        {
            "name": "PuddingAgent",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "pudding-build-frontend",
            "program": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/Source/PuddingAgent/PuddingAgent.csproj"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5000",
                "PUDDING_DATA_ROOT": "${workspaceFolder}/data",
                "PUDDING_LOG_LEVEL": "Debug",
                "Jwt__Key": "Pudding-Platform-JWT-DevKey-MUST-CHANGE-IN-PRODUCTION-32PLUS!",
                "Jwt__Issuer": "pudding-platform",
                "Jwt__Audience": "pudding-admin",
                "Jwt__ExpiryHours": "8",
                "Pudding__ControllerEndpoint": "http://localhost:5000"
            }
        }
    ]
}
