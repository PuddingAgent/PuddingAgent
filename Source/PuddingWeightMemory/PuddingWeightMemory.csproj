<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PuddingWeightMemory</RootNamespace>
  </PropertyGroup>

  <!--
    本地权重记忆召回的叶组件（组件化交付规程 S1；设计文档
    Docs/12_features/memory-design/2026-11-12-PuddingAgent本地权重记忆召回接入方案.md §2）。

    边界（依赖方向由**编译期失败**强制，target EnforceWeightMemoryLeafBoundary 在下方）：
      * 只允许 BCL + Microsoft.Data.Sqlite；
      * **禁止** ProjectReference —— 章节向量、打分、增量训练、快照全部只依赖内存中的 float[]，
        编码器通过 ITextEncoder 端口注入。这样"点积排序 / 四步梯度 / 快照比较交换"可以在
        没有 Host、没有 Python 编码进程的情况下被独立测试。

    数据库是 <DataRoot>/databases/weight-memory.db（宿主决定具体路径，组件只接受一个已解析的绝对路径）：
    派生数据独立成库，避免训练写锁与平台业务库争用。
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!--
      NU1903 治理（与 PuddingCodeIndex / PuddingLlmUsage.Storage 同一做法）：
      Microsoft.Data.Sqlite 10.0.9 把 SQLitePCLRaw.bundle_e_sqlite3 压在 2.1.11，
      后者解析出 SQLitePCLRaw.lib.e_sqlite3 2.1.11（advisory GHSA-2m69-gcr7-jv3q）。
      把同一个 bundle 钉到全仓已用的 2.1.13：不是引入新的依赖类别，只是把 Sqlite 驱动
      本就会拉取的 native e_sqlite3 拉到已修复版本，从而保持 0 warning。
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PuddingWeightMemoryTests" />
  </ItemGroup>

  <!--
    叶组件门禁：把"不得引用其它组件"从注释变成构建期失败。
    与 Directory.Build.targets 的 AllowedProjectReferences 同一手法（PUDDING001），
    这里用独立错误码，且额外守住"不得新增 NuGet 包"。
  -->
  <Target Name="EnforceWeightMemoryLeafBoundary" BeforeTargets="Build">
    <ItemGroup>
      <_WeightMemoryDirectReference Include="@(ProjectReference->WithMetadataValue('DefiningProjectFullPath', '$(MSBuildProjectFullPath)'))" />
      <_WeightMemoryAllowedPackage Include="Microsoft.Data.Sqlite" />
      <_WeightMemoryAllowedPackage Include="SQLitePCLRaw.bundle_e_sqlite3" />
      <_WeightMemoryPackageViolation Include="@(PackageReference)" Exclude="@(_WeightMemoryAllowedPackage)" />
    </ItemGroup>
    <Error Condition="'@(_WeightMemoryDirectReference)' != ''"
           Code="PUDDING003"
           Text="依赖方向违规：PuddingWeightMemory 是叶组件，禁止声明任何 ProjectReference（发现 [@(_WeightMemoryDirectReference->'%(Filename)', ', ')]）。" />
    <Error Condition="'@(_WeightMemoryPackageViolation)' != ''"
           Code="PUDDING004"
           Text="依赖违规：PuddingWeightMemory 只允许 Microsoft.Data.Sqlite（发现 [@(_WeightMemoryPackageViolation->'%(Identity)', ', ')]）。" />
  </Target>

</Project>
