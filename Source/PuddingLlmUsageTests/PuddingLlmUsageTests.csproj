<Project Sdk="MSTest.Sdk/4.0.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <!-- 组件测试（组件化交付规程 S2/S3）。
       边界：本工程只允许引用 PuddingLlmUsage。
       一旦它开始引用 PuddingRuntime / PuddingPlatform / Host，就说明"消耗规则"被宿主反向拖累，
       而那正是本组件存在的意义。边界由 PuddingLlmUsage_AssemblyReferencesNoProjectAssemblies 在运行时断言。 -->
  <ItemGroup>
    <ProjectReference Include="..\PuddingLlmUsage\PuddingLlmUsage.csproj" />
  </ItemGroup>

</Project>
