<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);TestFixtures/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuddingCodeIntelligence\PuddingCodeIntelligence.csproj" />
    <ProjectReference Include="..\PuddingCodeIndex\PuddingCodeIndex.csproj" />
    <!-- ADR-089 U4-4 D4: CLI file-walk exclusion lists are derived from this leaf. -->
    <ProjectReference Include="..\PuddingPathFiltering\PuddingPathFiltering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Scripts\extract-ts-symbols.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
