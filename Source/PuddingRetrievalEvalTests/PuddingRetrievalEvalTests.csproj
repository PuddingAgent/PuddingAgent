<Project Sdk="MSTest.Sdk/4.0.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <!-- Component tests for PuddingRetrievalEval (组件化交付规程 S2/S3).
       Boundary rule: this test project MUST reference PuddingRetrievalEval ONLY. It must never
       reference PuddingCodeIntelligence / PuddingRuntime / PuddingHost / PuddingAgent /
       PuddingCodeIndex, so the evaluation component can be built and tested without a host and
       without loading Roslyn/MSBuild. The boundary is asserted at runtime by ComponentBoundaryTests. -->
  <ItemGroup>
    <ProjectReference Include="..\PuddingRetrievalEval\PuddingRetrievalEval.csproj" />
  </ItemGroup>

</Project>
