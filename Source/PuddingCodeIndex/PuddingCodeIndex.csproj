<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Index component: maintains index artifacts (contracts, storage, change-capture pipeline,
       scheduling, scope registry/resolution, exclude patterns, path identity).
       Boundary rule (ADR-089 §2.1): this project MUST NOT reference PuddingCodeIntelligence. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PuddingCodeIndexTests" />
  </ItemGroup>

  <!-- ADR-089 U4-4 D4: index-side exclusion rules are derived from the single source in
       PuddingPathFiltering (a leaf with zero references of its own => no reverse dependency). -->
  <ItemGroup>
    <ProjectReference Include="..\PuddingPathFiltering\PuddingPathFiltering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- NU1903 remediation (2026-10-07): Microsoft.Data.Sqlite 10.0.9 floors SQLitePCLRaw.bundle_e_sqlite3
         at 2.1.11, which resolves SQLitePCLRaw.lib.e_sqlite3 2.1.11 (advisory GHSA-2m69-gcr7-jv3q).
         Pin the same bundle version PuddingMemoryEngine already uses (2.1.13) so the whole app ships
         a single native e_sqlite3 build. Evidence: dotnet restore of this project reports 0x NU1903,
         and project.assets.json resolves SQLitePCLRaw.lib.e_sqlite3/2.1.13. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
