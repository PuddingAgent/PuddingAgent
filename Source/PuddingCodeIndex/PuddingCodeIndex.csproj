<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Index component: maintains index artifacts (contracts, storage, change-capture pipeline,
       scheduling, scope registry/resolution, exclude patterns, path identity).
       Boundary rule (ADR-089 §2.1): this project MUST NOT reference PuddingCodeIntelligence. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PuddingCodeIndexTests" />
  </ItemGroup>

  <!-- ADR-089 U4-4 D4: index-side exclusion rules are derived from the single source in
       PuddingPathFiltering (a leaf with zero references of its own => no reverse dependency). -->
  <ItemGroup>
    <ProjectReference Include="..\PuddingPathFiltering\PuddingPathFiltering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
