<Project Sdk="Microsoft.NET.Sdk">
  <Target Name="EnforceWorkspacePortsBoundary" BeforeTargets="ResolveProjectReferences">
    <Error Condition="'@(ProjectReference)' != '' Or '@(PackageReference)' != ''" Text="Workspace ports use BCL only." />
    <Error Condition="'%(FrameworkReference.Identity)' != '' And '%(FrameworkReference.Identity)' != 'Microsoft.NETCore.App'" Text="Only the base runtime framework is allowed." />
  </Target>
</Project>
