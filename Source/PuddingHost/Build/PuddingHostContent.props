<Project>
  <!--
    Shared content items for Console (PuddingAgent) and Desktop (PuddingDesktop) hosts.
    Imported by consuming projects. Paths are relative to MSBuildThisFileDirectory (Build/).
  -->
  <PropertyGroup>
    <!-- Allow a verified, isolated frontend build to be bundled without replacing dev dist. -->
    <PuddingAdminDistPath Condition="'$(PuddingAdminDistPath)' == ''">$(MSBuildThisFileDirectory)..\..\PuddingPlatformAdmin\dist</PuddingAdminDistPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- default-data tree -->
    <Content Include="$(MSBuildThisFileDirectory)..\default-data\**\*"
             Exclude="$(MSBuildThisFileDirectory)..\default-data\assets\agent-avatars\**\*.png"
             Link="default-data\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <!-- Agent avatar PNGs → output wwwroot/assets/agent-avatars (served at /assets/agent-avatars/*.png).
         Physical wwwroot is the runtime source of truth (see PuddingWebApplicationExtensions.cs);
         static-web-assets manifest endpoints are NOT used. -->
    <Content Include="$(MSBuildThisFileDirectory)..\default-data\assets\agent-avatars\**\*.png"
             Link="wwwroot\assets\agent-avatars\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <!-- Agent avatars config -->
    <Content Include="$(MSBuildThisFileDirectory)..\Config\agent-avatars.json" Link="Config\agent-avatars.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <!-- Heartbeat prompt -->
    <Content Include="$(MSBuildThisFileDirectory)..\Prompts\HeartbeatPrompt.md" Link="Prompts\HeartbeatPrompt.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- Admin SPA (Workbench) — PuddingPlatformAdmin/dist/** → wwwroot/admin/** -->
    <Content Include="$(PuddingAdminDistPath)\**\*"
             Link="wwwroot\admin\%(RecursiveDir)%(Filename)%(Extension)"
             Condition="Exists('$(PuddingAdminDistPath)\index.html')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Publish-time check: admin SPA must be built -->
  <Target Name="EnsureAdminDistExists" BeforeTargets="Publish" Condition="'$(SkipAdminDistCheck)' != 'true'">
    <Error Condition="!Exists('$(PuddingAdminDistPath)\index.html')"
           Text="Admin SPA is missing at $(PuddingAdminDistPath). Build Source/PuddingPlatformAdmin first and set PuddingAdminDistPath to its output, or set SkipAdminDistCheck=true for backend-only development." />
  </Target>
</Project>
