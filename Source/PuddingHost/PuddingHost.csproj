<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PuddingHost</AssemblyName>
    <RootNamespace>PuddingHost</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.14.28" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="17.14.28" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!--
      安全修复（2026-11-01）：传递依赖 System.Security.Cryptography.Pkcs 被解析到 9.0.4，命中
      GHSA-846f-f764-76mx（High）与 GHSA-2fmv-rv2c-59x7（Moderate）。
      没有任何 csproj 直接引用它，所以只能显式上提覆盖传递解析；选 10.0.14 与 PuddingMemoryEngine
      已用的 10.0.12 同线，使整张 shipped 依赖图只剩一个 Pkcs 版本。
      验收判据：dotnet list 的 package 漏洞审计（vulnerable + include-transitive 两个开关）
      不再列出该包 —— 不是靠人工推断的「应该好了」。
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Map" Version="2.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuddingComputer.Windows\PuddingComputer.Windows.csproj" />
    <ProjectReference Include="..\PuddingSlack\PuddingSlack.csproj" />
    <ProjectReference Include="..\PuddingDingTalk\PuddingDingTalk.csproj" />
    <ProjectReference Include="..\PuddingCore\PuddingCore.csproj" />
    <ProjectReference Include="..\PuddingPlatform\PuddingPlatform.csproj" />
    <ProjectReference Include="..\PuddingInvocationPipeline\PuddingInvocationPipeline.csproj" />
    <ProjectReference Include="..\PuddingController\PuddingController.csproj" />
    <ProjectReference Include="..\PuddingRuntime\PuddingRuntime.csproj" />
    <ProjectReference Include="..\PuddingMemoryEngine\PuddingMemoryEngine.csproj" />
    <ProjectReference Include="..\..\external\github.hyfree.GM\github.hyfree.GM\github.hyfree.GM.csproj" />
    <ProjectReference Include="..\HarnessAgent.Core\HarnessAgent.Core.csproj" />
    <ProjectReference Include="..\PuddingBrowser.Protocol\PuddingBrowser.Protocol.csproj" />
    <ProjectReference Include="..\PuddingBrowser.Abstractions\PuddingBrowser.Abstractions.csproj" />
    <!-- S5 接入（2026-10-08）：Bridge 路径与 DesktopService 路径共用同一份变更类后置条件。 -->
    <ProjectReference Include="..\PuddingBrowser.Automation\PuddingBrowser.Automation.csproj" />
    <ProjectReference Include="..\PuddingBrowser.AgentTools\PuddingBrowser.AgentTools.csproj" />
    <!-- 切片 C-3：桌面能力通道（Desktop 主动 gRPC 双向流）。默认关闭，见 DesktopCapabilityChannelWiring。 -->
    <ProjectReference Include="..\Pudding.CapabilityBroker\Pudding.CapabilityBroker.csproj" />
    <ProjectReference Include="..\Pudding.CapabilityBroker.AspNetCore\Pudding.CapabilityBroker.AspNetCore.csproj" />
    <!-- S5 接入（2026-10-19）：Home Assistant 叶子组件。域策略与输出预算在组件内强制，
         Host 只负责配置解析、工具适配与审批口径。 -->
    <ProjectReference Include="..\PuddingHomeAssistant\PuddingHomeAssistant.csproj" />
  </ItemGroup>

</Project>
