<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="EnforceSchedulingProjectBoundary" BeforeTargets="PrepareForBuild">
    <Error Condition="'@(ProjectReference)' != ''" Text="PuddingScheduling must not reference other projects." />
  </Target>
</Project>
