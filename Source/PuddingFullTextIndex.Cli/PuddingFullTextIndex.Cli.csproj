<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PuddingFullTextIndex.Cli</AssemblyName>
    <RootNamespace>PuddingFullTextIndex.Cli</RootNamespace>
  </PropertyGroup>

  <!--
    A3 边界：本工程只引用 A1 组件（PuddingFullTextIndex），不引用 Host/Agent/Runtime/Platform，
    也不新增任何 NuGet 包（Lucene / jieba 由 A1 组件传递而来）。
    组件没有 DI 文件 ⇒ 本 CLI 自行组装组合根（SupplyCliHost），不引入 DI 容器。
  -->
  <ItemGroup>
    <ProjectReference Include="..\PuddingFullTextIndex\PuddingFullTextIndex.csproj" />
  </ItemGroup>

  <!-- 核心逻辑（SupplyCli / 解析 / 镜像口径）对测试工程可见，单测不必起进程。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="PuddingFullTextIndex.Cli.Tests" />
  </ItemGroup>

  <!--
    ⚠️ 本工程**不**登记进 PuddingAgentNetwork.slnx（唯一解决方案文件在并发工作流手里，
    S5 干净窗口再登记）。因此必须能独立 `dotnet build Source/PuddingFullTextIndex.Cli`。
  -->

</Project>
