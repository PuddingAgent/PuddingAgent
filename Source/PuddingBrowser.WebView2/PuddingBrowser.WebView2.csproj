<Project Sdk="Microsoft.NET.Sdk">
  <!--
    PuddingBrowser.WebView2 — WebView2-based browser driver for Windows.
    Phase 3: Implements IBrowserRuntime/Context/Page via WebView2.
    Must NOT reference Douyin.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PuddingBrowser.WebView2</AssemblyName>
    <RootNamespace>PuddingBrowser.WebView2</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuddingBrowser.Abstractions\PuddingBrowser.Abstractions.csproj" />
    <!--
      原生输入（CDP 键鼠）的**调用序列规划**在 PuddingBrowser.Automation 里：
      按下必成对抬起、修饰键顺序、取消清理这些规则必须只有一份，驱动只负责按序发出去。
      方向是"执行层 → 规则层"（Automation 只引用 Contracts，不会反向引用驱动），无环。
    -->
    <ProjectReference Include="..\PuddingBrowser.Automation\PuddingBrowser.Automation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PuddingDesktop.Tests" />
  </ItemGroup>
</Project>
