<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Pudding.DesktopService</RootNamespace>
    <AssemblyName>Pudding.DesktopService</AssemblyName>
  </PropertyGroup>

  <!--
    Desktop 侧服务（计划 §6）：目标校验、准入、生命周期、取消与关闭竞态、UI 线程边界。
    依赖 Contracts（平台无关契约）+ DesktopConnection（执行器接缝）。
    禁止引用 WinUI/WebView2/ASP.NET Core/宿主：DispatcherQueue 适配与 WebView2 动作留在实现程序集。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Pudding.DesktopServiceTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pudding.Contracts\Pudding.Contracts.csproj" />
    <ProjectReference Include="..\Pudding.DesktopConnection\Pudding.DesktopConnection.csproj" />
    <!--
      S5 接入（2026-10-08）：变更类后置条件必须与 Bridge 路径共用同一份纯逻辑，
      否则两条传输会各自验出相反结论。PuddingBrowser.Automation 是纯逻辑组件
      （只引用 Pudding.Contracts，无 UI / 驱动 / WebView2 依赖），不越过下面的边界门禁。
    -->
    <ProjectReference Include="..\PuddingBrowser.Automation\PuddingBrowser.Automation.csproj" />
    <!--
      ADR-097 D3（2026-10-18）：浏览器会话授权收敛为独立纯规则组件
      （PuddingBrowser.Authorization 只引用 Contracts）。本层是它的**唯一生产持有者**：
      Shell/桥侧只经标量门面调用，不直接引用该组件（继续遵守 Shell 引用白名单）。
    -->
    <ProjectReference Include="..\PuddingBrowser.Authorization\PuddingBrowser.Authorization.csproj" />
    <!-- 驱动策略注入（§7/§8）：驱动源码只依赖 Abstractions，适配器放在双方都能引用的这一层。 -->
    <ProjectReference Include="..\PuddingBrowser.Abstractions\PuddingBrowser.Abstractions.csproj" />
  </ItemGroup>

  <Target Name="EnforceDesktopServiceBoundary" BeforeTargets="ResolveReferences">
    <PropertyGroup>
      <_DesktopServiceProjectReferences>@(ProjectReference)</_DesktopServiceProjectReferences>
      <_DesktopServicePackageReferences>@(PackageReference)</_DesktopServicePackageReferences>
    </PropertyGroup>
    <Error Condition="$(_DesktopServiceProjectReferences.Contains('PuddingHost')) Or $(_DesktopServiceProjectReferences.Contains('PuddingRuntime')) Or $(_DesktopServiceProjectReferences.Contains('PuddingDesktop')) Or $(_DesktopServiceProjectReferences.Contains('Pudding.Browser')) Or $(_DesktopServiceProjectReferences.Contains('PuddingAgent'))"
           Text="Pudding.DesktopService must not reference the host, runtime, desktop shell or browser UI projects." />
    <Error Condition="$(_DesktopServicePackageReferences.Contains('Microsoft.AspNetCore')) Or $(_DesktopServicePackageReferences.Contains('Microsoft.UI')) Or $(_DesktopServicePackageReferences.Contains('WebView2'))"
           Text="Pudding.DesktopService must not reference ASP.NET Core, WinUI or WebView2 packages." />
  </Target>

  </Project>
