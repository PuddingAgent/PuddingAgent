<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><TreatWarningsAsErrors>true</TreatWarningsAsErrors></PropertyGroup>
  <Target Name="EnforceChatBoundary" BeforeTargets="ResolveReferences">
    <Error Condition="'@(ProjectReference)' != '' Or '@(PackageReference)' != ''" Text="Chat contracts and client are a BCL-only leaf." />
  </Target>
</Project>
