<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 一次性历史脏数据诊断/修复工具（看板卡 4ed930e7 原子任务③）。默认 dry-run，显式 apply 参数才写库。 -->
    <RootNamespace>PuddingTaskRecall.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 枚举单一事实来源：PuddingCore（WorkspaceTaskStatus/TaskEventType/TaskStateMachine）、
         PuddingPlatform.Data.Entities（AssignmentAttemptStatus）。 -->
    <ProjectReference Include="..\PuddingPlatform\PuddingPlatform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
  </ItemGroup>

</Project>
