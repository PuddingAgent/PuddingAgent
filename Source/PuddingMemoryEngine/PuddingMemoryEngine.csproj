<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- Keep EF Design's Roslyn tooling aligned with PuddingCodeIntelligence so publish has one BuildHost version. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" PrivateAssets="all" />
    <PackageReference Include="jieba.NET" Version="0.42.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- NU1903 remediation (2026-10-07): the build-time graph pulls Microsoft.Build.Tasks.Core
         (17.14.28), which floors System.Security.Cryptography.Xml at 9.0.0 - flagged by 8 advisories
         (GHSA-23rf-6693-g89p, 37gx-xxp4-5rgx, 6588-8gv4-xfgh, 8q5v-6pqq-x66h, cvvh-rhrc-wg4q,
         g8r8-53c2-pm3f, mmjf-rqrv-855v, w3x6-4m5h-cxqf). Pin the 10.0.x line (10.0.10 is the
         first patched 10.0.x release) rather than bumping the Roslyn workspaces package, whose
         version is deliberately kept aligned with PuddingCodeIntelligence.
         Evidence: dotnet restore of this project reports 0x NU1903 for System.Security.Cryptography.Xml. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageReference Include="System.Drawing.Common" Version="4.7.3" />
    <!-- jieba.NET (netstandard2.0) 的运行时依赖：JiebaNet ConfigManager 需要该程序集。
         不显式声明时不会流入下游应用输出目录，导致 JiebaSegmenter 类型初始化失败。 -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PuddingMemoryEngineTests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Schema\init_memory.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Schema\init_library.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Jieba 资源文件：从 NuGet 缓存声明为 None 项并复制到输出目录。
    CopyToOutputDirectory=PreserveNewest 确保 PuddingMemoryEngine 自身输出包含 Resources/。
    下游项目的传递复制由 build/PuddingMemoryEngine.JiebaResources.targets 负责。
  -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)jieba.net\0.42.2\Resources\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="Resources\%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuddingCore\PuddingCore.csproj" />
    <ProjectReference Include="..\PuddingFullTextIndex\PuddingFullTextIndex.csproj" />
  </ItemGroup>

</Project>
