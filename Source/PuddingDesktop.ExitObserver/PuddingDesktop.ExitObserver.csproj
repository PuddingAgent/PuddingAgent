<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup><ProjectReference Include="../PuddingDesktop.Diagnostics/PuddingDesktop.Diagnostics.csproj" /></ItemGroup>
  <Target Name="EnforceObserverBoundary" BeforeTargets="ResolveReferences">
    <Error Condition="'@(PackageReference)' != ''" Text="Exit observer must remain BCL-only." />
    <ItemGroup><Forbidden Include="@(ProjectReference)" Condition="'%(Filename)' != 'PuddingDesktop.Diagnostics'" /></ItemGroup>
    <Error Condition="'@(Forbidden)' != ''" Text="Exit observer may reference diagnostics only." />
  </Target>
</Project>
