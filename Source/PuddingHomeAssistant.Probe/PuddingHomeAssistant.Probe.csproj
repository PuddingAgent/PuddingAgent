<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PuddingHomeAssistant.Probe</AssemblyName>
    <RootNamespace>PuddingHomeAssistant.Probe</RootNamespace>
  </PropertyGroup>

  <!-- S3 无宿主验证程序（组件化交付规程）：只引用 PuddingHomeAssistant 一个项目，
       不装配 Core / 不读 DataRoot / 不引用任何 Pudding 上层工程。
       用法：PuddingHomeAssistant.Probe <baseUrl> <token> -->
  <ItemGroup>
    <ProjectReference Include="..\PuddingHomeAssistant\PuddingHomeAssistant.csproj" />
  </ItemGroup>

</Project>
