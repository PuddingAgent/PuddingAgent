<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\temp\build\winui3\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\temp\build\winui3\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PuddingDesktop</AssemblyName>
    <RootNamespace>PuddingDesktop</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;**/TestResults/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PuddingDesktop.Foundation\PuddingDesktop.Foundation.csproj" />
    <ProjectReference Include="..\PuddingDesktop.Composition\PuddingDesktop.Composition.csproj" />
    <ProjectReference Include="..\PuddingChat\PuddingChat.csproj" />
    <ProjectReference Include="..\PuddingChat.WinUI\PuddingChat.WinUI.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>
  <Target Name="EnforceShellBoundary" BeforeTargets="ResolveReferences">
    <ItemGroup>
      <_ForbiddenShellReference Include="@(ProjectReference)" Condition="'%(Filename)' != 'PuddingDesktop.Foundation' And '%(Filename)' != 'PuddingDesktop.Composition' And '%(Filename)' != 'PuddingChat' And '%(Filename)' != 'PuddingChat.WinUI'" />
    </ItemGroup>
    <Error Condition="'@(_ForbiddenShellReference)' != ''" Text="WinUI shell may reference only Foundation, Composition and native Chat components. Host services stay behind the composition boundary." />
  </Target>
  <Import Project="..\PuddingHost\Build\PuddingHostContent.props" />
  <Target Name="IncludeWinUiShellResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <!-- Unpackaged SDK publishing must carry the app's generated resource index and XAML binaries. -->
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI application PRI is missing; build the shell before publishing." />
    <ItemGroup>
      <_WinUiShellResource Include="$(TargetDir)$(AssemblyName).pri;$(TargetDir)*.xbf" />
      <ResolvedFileToPublish Remove="@(_WinUiShellResource)" />
      <ResolvedFileToPublish Include="@(_WinUiShellResource)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
