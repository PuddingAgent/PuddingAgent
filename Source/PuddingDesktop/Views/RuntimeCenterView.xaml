<UserControl x:Class="PuddingDesktop.Views.RuntimeCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="clr-namespace:PuddingDesktop.Hosting">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="RuntimeDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCoreRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static hosting:DesktopStartupState.CoreFailed}">
                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static hosting:DesktopStartupState.CoreCircuitOpen}">
                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1080"
              Margin="40,34,40,48"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="运行中心" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="查看并控制 Desktop 托管的 ASP.NET Core 进程、恢复策略和诊断输出。"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="启动"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{Binding CanStart}"
                            Click="Start_Click" />
                    <Button Content="停止"
                            Margin="8,0,0,0"
                            Style="{StaticResource DefaultButtonStyle}"
                            IsEnabled="{Binding CanStop}"
                            Click="Stop_Click" />
                    <Button Content="重启"
                            Margin="8,0,0,0"
                            Style="{StaticResource DefaultButtonStyle}"
                            IsEnabled="{Binding CanRestart}"
                            Click="Restart_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,24,0,0"
                    Padding="24"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58"
                            Background="{DynamicResource AccentLightBrush}"
                            CornerRadius="16">
                        <TextBlock Text="&#xE950;"
                                   Style="{StaticResource FluentIconTextStyle}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="25" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource RuntimeDotStyle}" Margin="0,0,9,0" />
                            <TextBlock Text="{Binding StatusText}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusDescription}"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Padding="12,7"
                            Background="{DynamicResource SubtleFillBrush}"
                            CornerRadius="16"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding BoundAddress}"
                                   ToolTip="{Binding LocalControlAddress}"
                                   FontSize="12" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="15"
                    Background="{DynamicResource ErrorFillBrush}"
                    BorderBrush="{DynamicResource ErrorBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA39;"
                               Style="{StaticResource FluentIconTextStyle}"
                               Foreground="{DynamicResource ErrorBrush}"
                               Margin="0,1,10,0" />
                    <StackPanel>
                        <TextBlock Text="需要处理" Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastError}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <UniformGrid Grid.Row="3" Columns="4" Margin="-6,6,-6,0">
                <Border Margin="6" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding ProcessIdLabel}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding ProcessIdText}" Margin="0,8,0,0" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="6" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="运行时间" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding UptimeText}" Margin="0,8,0,0" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="6" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="健康检查" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding HealthText}" Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Margin="6" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="最近退出码" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding LastExitCodeText}" Margin="0,8,0,0" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="4" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="异常恢复" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="连续失败会按 2s / 4s / 8s 退避，并在达到阈值后熔断。"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,14" />
                        <CheckBox x:Name="AutoRestartCheck"
                                  Content="Core 意外退出后自动恢复"
                                  IsChecked="{Binding AutoRestartEnabled, Mode=OneWay}"
                                  Click="AutoRestart_Click" />
                        <TextBlock Text="{Binding RestartStatusText}"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="运行环境" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="启动时间" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding StartedAtText}" FontSize="13" />
                            <TextBlock Grid.Row="1" Text="DataRoot" Margin="0,9,0,0" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataRoot}" Margin="0,9,0,0" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="可执行文件" Margin="0,9,0,0" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CoreExecutablePath}" Margin="0,9,0,0" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="5"
                    Margin="0,12,0,0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="340" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="最近 Core 输出" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="内存环形缓冲区最近 500 行；不会重新执行 Core 或读取浏览器 Cookie。"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="复制"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    Click="CopyLogs_Click" />
                            <Button Content="打开日志目录"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    Click="OpenLogs_Click" />
                            <Button Content="生成诊断包"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="CreateDiagnostic_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBox Grid.Row="1"
                             Margin="0,16,0,0"
                             Height="Auto"
                             MinHeight="300"
                             Padding="12,10"
                             Text="{Binding CoreLogText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             AutomationProperties.Name="最近 Core 输出" />
                </Grid>
            </Border>

            <TextBlock x:Name="FeedbackText"
                       Grid.Row="6"
                       Margin="0,14,0,0"
                       Visibility="Collapsed"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</UserControl>
