<UserControl x:Class="PuddingDesktop.Views.CoreStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="clr-namespace:PuddingDesktop.Hosting">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="StateIconBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WarningFillBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static hosting:DesktopStartupState.CoreReady}">
                    <Setter Property="Background" Value="{DynamicResource SuccessFillBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static hosting:DesktopStartupState.WebViewInitializing}">
                    <Setter Property="Background" Value="{DynamicResource SuccessFillBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static hosting:DesktopStartupState.WorkbenchReady}">
                    <Setter Property="Background" Value="{DynamicResource SuccessFillBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static hosting:DesktopStartupState.CoreFailed}">
                    <Setter Property="Background" Value="{DynamicResource ErrorFillBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static hosting:DesktopStartupState.WorkbenchFailed}">
                    <Setter Property="Background" Value="{DynamicResource ErrorFillBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateIconStyle" TargetType="TextBlock" BasedOn="{StaticResource FluentIconTextStyle}">
            <Setter Property="Text" Value="&#xE895;" />
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            <Setter Property="FontSize" Value="24" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCoreRunning}" Value="True">
                    <Setter Property="Text" Value="&#xE73E;" />
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Text" Value="&#xEA39;" />
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PageStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCoreRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1040"
              HorizontalAlignment="Center"
              Margin="40,34,40,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Core 与诊断" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="查看桌面启动器、ASP.NET Core 子进程和 Workbench 的运行状态。"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Margin="0,24,0,0"
                    Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="56" Height="56"
                            CornerRadius="16"
                            Style="{StaticResource StateIconBorderStyle}">
                        <TextBlock Style="{StaticResource StateIconStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="18,0,24,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusDescription}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Padding="12,7"
                            Background="{DynamicResource SubtleFillBrush}"
                            CornerRadius="16"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource PageStatusDotStyle}"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="{Binding BoundAddress}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="16"
                    Background="{DynamicResource ErrorFillBrush}"
                    BorderBrush="{DynamicResource ErrorBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEA39;"
                               Style="{StaticResource FluentIconTextStyle}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="18"
                               Margin="0,1,12,0"
                               VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="需要处理"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastError}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="&#xE968;"
                                   Style="{StaticResource FluentIconTextStyle}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="20"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="本地 API"
                                   Margin="0,14,0,0"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BoundAddress}"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="仅绑定回环地址，由 Desktop 控制端口。"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="&#xED25;"
                                   Style="{StaticResource FluentIconTextStyle}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="20"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="数据目录"
                                   Margin="0,14,0,0"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DataRoot}"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="配置、会话、记忆和浏览器资料均在此保存。"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="&#xE950;"
                                   Style="{StaticResource FluentIconTextStyle}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="20"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="进程隔离"
                                   Margin="0,14,0,0"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Desktop → PuddingAgent"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13" />
                        <TextBlock Text="Core 失败不会关闭桌面；退出时自动回收子进程。"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
