<UserControl x:Class="PuddingDesktop.Views.BrowserWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Tab Strip ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tab items (horizontal scroll) -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" x:Name="TabScrollViewer">
                    <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabBorder" Margin="2,0" Padding="10,5" CornerRadius="6"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="TabItem_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="10" Margin="0,0,5,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Visibility="{Binding IsAgentTarget, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   ToolTip="Agent target" />
                                        <TextBlock Text="{Binding Title}" MaxWidth="140"
                                                   TextTrimming="CharacterEllipsis" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text=" &#xE711;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="10" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Cursor="Hand"
                                                   MouseLeftButtonUp="TabClose_Click"
                                                   ToolTip="Close tab"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- New Tab button -->
                <Button Grid.Column="1" x:Name="NewTabButton" Click="NewTab_Click"
                        Width="28" Height="28" Margin="4,0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="New tab">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ Row 1: Toolbar ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="6,4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BackButton" Click="Back_Click" Width="30" Height="30"
                            IsEnabled="{Binding CanGoBack}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Back">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button x:Name="ForwardButton" Click="Forward_Click" Width="30" Height="30"
                            IsEnabled="{Binding CanGoForward}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Forward">
                        <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button x:Name="ReloadStopButton" Click="ReloadStop_Click" Width="30" Height="30"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Reload / Stop">
                        <TextBlock x:Name="ReloadStopIcon" Text="&#xE72C;" FontFamily="Segoe Fluent Icons"
                                   FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </StackPanel>

                <!-- Address bar -->
                <Border Grid.Column="1" Margin="6,0" CornerRadius="6"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBox x:Name="AddressBar" KeyDown="AddressBar_KeyDown"
                             VerticalContentAlignment="Center" Padding="8,4"
                             FontSize="13" BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                </Border>

                <!-- Agent handoff button -->
                <Button Grid.Column="2" x:Name="AgentHandoffButton" Click="AgentHandoff_Click"
                        Padding="8,4" Margin="4,0,0,0" Cursor="Hand"
                        Background="{DynamicResource AccentBrush}" BorderThickness="0"
                        ToolTip="Hand this page to Agent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text=" Agent" FontSize="12" Foreground="White"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ Row 2: Content Area (Surface + Activity Pane) ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- WebView2 Surface Container -->
            <Grid Grid.Column="0" x:Name="SurfaceContainer" Background="{DynamicResource BackgroundBrush}">
                <!-- Empty state when no tabs -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Visible">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="48"
                               HorizontalAlignment="Center" Margin="0,0,0,12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="No open tabs" FontSize="15" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="Click + to open a new tab" FontSize="12" HorizontalAlignment="Center"
                               Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <Border x:Name="InitializationErrorPanel"
                        Panel.ZIndex="20"
                        Width="420" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment=" Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                        CornerRadius="12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Agent Browser 初始化失败"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="InitializationErrorText"
                                   Margin="0,8,0,16" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="重试初始化" Click="RetryInitialization_Click"
                                HorizontalAlignment="Left" Padding="14,6" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Agent Activity Pane (collapsible, ~300px) -->
            <Border Grid.Column="1" x:Name="ActivityPane" Width="300"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Pane header with Export button -->
                    <Border Grid.Row="0" Padding="10,8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Agent Activity" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ExportActivityButton" Click="ExportActivity_Click"
                                        Width="Auto" Height="24" Padding="6,0"
                                        Background="{DynamicResource SubtleFillBrush}" BorderThickness="0"
                                        Cursor="Hand" ToolTip="Export sanitized activity record"
                                        FontSize="11" Content="导出记录"
                                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Button x:Name="CollapsePaneButton" Click="CollapsePane_Click"
                                        Width="24" Height="24" Margin="4,0,0,0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Collapse panel">
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bridge status -->
                    <Border Grid.Row="1" Padding="10,6">
                        <StackPanel>
                            <TextBlock Text="Bridge Status" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="BridgeStatusText" Text="Disconnected" FontSize="12"
                                       Margin="0,2,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Agent Status Card (doc 6.3): compact status display -->
                    <Border Grid.Row="2" Padding="10,6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            x:Name="AgentStatusCard">
                        <StackPanel>
                            <!-- State indicator row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,6,0"
                                         Fill="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusTitleText" Text="等待 Agent 操作"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Agent summary line -->
                            <TextBlock x:Name="AgentSummaryLine" Text="-"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="14,0,0,1" TextWrapping="Wrap"/>
                            <!-- Target line -->
                            <TextBlock x:Name="AgentTargetLine" Text="目标：-"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="14,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Control state + buttons -->
                    <Border Grid.Row="3" Padding="10,6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Control" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="ControlStateText" Text="Idle" FontSize="12"
                                       Margin="0,2,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <WrapPanel>
                                <Button x:Name="PauseButton" Click="Pause_Click" Content="Pause"
                                        Margin="0,0,4,4" Padding="8,3" FontSize="11" Cursor="Hand"/>
                                <Button x:Name="TakeoverButton" Click="Takeover_Click" Content="Takeover"
                                        Margin="0,0,4,4" Padding="8,3" FontSize="11" Cursor="Hand"/>
                                <Button x:Name="ResumeButton" Click="Resume_Click" Content="Resume"
                                        Margin="0,0,4,4" Padding="8,3" FontSize="11" Cursor="Hand"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Activity log -->
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="10,6">
                        <ItemsControl x:Name="ActivityList" ItemsSource="{Binding Activities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,3" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                                                <Run Text="{Binding CommandName, Mode=OneWay}"/>
                                                <Run Text=" → " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Run Text="{Binding Target, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding StartedAt, Mode=OneWay, StringFormat=HH:mm:ss}"/>
                                                <Run Text="{Binding ErrorCode, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Target summary -->
                    <Border Grid.Row="5" Padding="10,6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock x:Name="TargetSummaryText" Text="{Binding AgentTargetSummary}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Row 3: Status Bar ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="8,3"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusBarText" Text="Ready" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button x:Name="ExpandPaneButton" Click="ExpandPane_Click"
                        HorizontalAlignment="Right" Visibility="Collapsed"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="Show Activity Panel">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
