<UserControl x:Class="PuddingDesktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="920"
              HorizontalAlignment="Center"
              Margin="40,34,40,48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="系统设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="配置 Desktop 启动器、Core 子进程和本地数据存储。缺少配置不会阻止启动器打开。"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- Storage -->
            <Border Grid.Row="1"
                    Margin="0,24,0,0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentLightBrush}"
                            CornerRadius="9">
                        <TextBlock Text="&#xED25;"
                                   Style="{StaticResource FluentIconTextStyle}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="17" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="存储与程序位置" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="数据目录保存 Agent 配置、会话、记忆、日志和隔离的浏览器资料。"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,18" />

                        <TextBlock Text="数据目录" FontWeight="SemiBold" FontSize="13" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DataRootBox"
                                     Text="{Binding DataRoot, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Content="浏览…"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    Click="BrowseDataRoot_Click" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="验证目录"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    Click="ValidateDataRoot_Click" />
                            <Button Content="创建目录"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    Click="CreateDirectory_Click" />
                        </StackPanel>

                        <Border Height="1"
                                Margin="0,20,0,18"
                                Background="{DynamicResource DividerBrush}" />

                        <TextBlock Text="Core 可执行文件（可选）" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="留空时优先使用随 Desktop 发布的 core/PuddingAgent.exe。"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CoreExecutableBox"
                                     Text="{Binding CoreExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Content="选择…"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    Click="BrowseCoreExecutable_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Core lifecycle -->
            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentLightBrush}"
                            CornerRadius="9">
                        <TextBlock Text="&#xE950;"
                                   Style="{StaticResource FluentIconTextStyle}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="17" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Core 生命周期" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="这些参数由 Desktop 传递并监督；HTTP 仅绑定本机回环地址。"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,16" />

                        <CheckBox x:Name="AutoStartCheck"
                                  IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                  Content="启动 Desktop 后自动启动 Core"
                                  Margin="0,0,0,18" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="HTTP 端口" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="0 = 自动分配"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,3,0,7" />
                                <TextBox x:Name="PortBox"
                                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="启动超时" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="1–600 秒"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,3,0,7" />
                                <TextBox x:Name="StartupTimeoutBox"
                                         Text="{Binding StartupTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="停止超时" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="1–120 秒"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,3,0,7" />
                                <TextBox x:Name="ShutdownTimeoutBox"
                                         Text="{Binding ShutdownTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1"
                                Margin="0,20,0,18"
                                Background="{DynamicResource DividerBrush}" />

                        <CheckBox IsChecked="{Binding AutoRestart, Mode=TwoWay}"
                                  Content="Core 意外退出后自动恢复"
                                  Margin="0,0,0,14" />

                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="最多尝试" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="1–20 次"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,3,0,7" />
                                <TextBox x:Name="RestartAttemptsBox"
                                         Text="{Binding RestartMaxAttempts, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <TextBlock Text="统计窗口" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="10–3600 秒"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,3,0,7" />
                                <TextBox x:Name="RestartWindowBox"
                                         Text="{Binding RestartWindowSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <TextBlock Text="初始延迟" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="默认 2 秒"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,3,0,7" />
                                <TextBox x:Name="RestartInitialDelayBox"
                                         Text="{Binding RestartInitialDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="最大延迟" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="默认 30 秒"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,3,0,7" />
                                <TextBox x:Name="RestartMaxDelayBox"
                                         Text="{Binding RestartMaxDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Desktop background behavior -->
            <Border Grid.Row="3"
                    Margin="0,12,0,0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentLightBrush}"
                            CornerRadius="9">
                        <TextBlock Text="&#xE7F4;"
                                   Style="{StaticResource FluentIconTextStyle}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="17" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="桌面后台与托盘" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Pudding Desktop 是产品进程主管；关闭窗口后可继续守护 Core 和本地 API。"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,14" />
                        <CheckBox IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                  Content="关闭窗口时隐藏到系统托盘（取消后将退出并停止 Core）" />
                        <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  Content="登录 Windows 后在后台启动 Pudding"
                                  Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Security -->
            <Border Grid.Row="4"
                    Margin="0,12,0,0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource SuccessFillBrush}"
                            CornerRadius="9">
                        <TextBlock Text="&#xEA18;"
                                   Style="{StaticResource FluentIconTextStyle}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="17" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="桌面控制令牌" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="令牌存储在 system.json，用于保护 Desktop → Core 的内部控制接口。"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="7" Height="7"
                                     Fill="{DynamicResource SuccessBrush}"
                                     Margin="0,0,7,0" />
                            <TextBlock x:Name="TokenStatus"
                                       Text="{Binding TokenStatusText}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="重新生成"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource DefaultButtonStyle}"
                            Click="RegenerateToken_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="5"
                    Margin="0,12,0,0"
                    Padding="14"
                    Background="{DynamicResource ErrorFillBrush}"
                    BorderBrush="{DynamicResource ErrorBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA39;"
                               Style="{StaticResource FluentIconTextStyle}"
                               Foreground="{DynamicResource ErrorBrush}"
                               Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ValidationError}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="6" Margin="0,20,0,0">
                <TextBlock x:Name="SaveFeedback"
                           Visibility="Collapsed"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource SuccessBrush}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RestartButton"
                            Content="重启 Core"
                            Margin="0,0,8,0"
                            Style="{StaticResource DefaultButtonStyle}"
                            Click="RestartCore_Click" />
                    <Button Content="保存设置"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SaveDataRoot_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
