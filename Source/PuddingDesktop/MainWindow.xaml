<Window x:Class="PuddingDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PuddingDesktop.Views"
        xmlns:hosting="clr-namespace:PuddingDesktop.Hosting"
        Title="Pudding"
        Width="1360" Height="840"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CoreStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static hosting:DesktopStartupState.CoreReady}">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static hosting:DesktopStartupState.WebViewInitializing}">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static hosting:DesktopStartupState.WorkbenchReady}">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static hosting:DesktopStartupState.CoreFailed}">
                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static hosting:DesktopStartupState.WorkbenchFailed}">
                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <!-- Drag region and native-like caption buttons -->
        <Grid Grid.Row="0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Border Width="24" Height="24"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="6">
                    <TextBlock Text="P"
                               Foreground="White"
                               FontFamily="{StaticResource DisplayFont}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Pudding"
                           Margin="10,0,0,0"
                           FontFamily="{StaticResource DisplayFont}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <Border Width="1" Height="14"
                        Margin="12,0"
                        Background="{DynamicResource DividerBrush}" />
                <TextBlock Text="Desktop Preview"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#xE921;"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="MinimizeButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="最小化" />
                <Button x:Name="MaximizeButton"
                        Content="&#xE922;"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="MaximizeButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="最大化" />
                <Button Content="&#xE8BB;"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="CloseButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="关闭" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Windows 11 NavigationView-like pane -->
            <Border Grid.Column="0"
                    Margin="8,0,0,8"
                    Background="{DynamicResource NavigationFillBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource LargeCorner}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="导航"
                               Margin="20,18,16,8"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold" />

                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="navWorkbench"
                                     GroupName="MainNavigation"
                                     Tag="&#xE80F;"
                                     Content="工作台"
                                     ToolTip="Workbench"
                                     Style="{StaticResource NavItemStyle}"
                                     IsChecked="True"
                                     Checked="NavButton_Checked" />
                        <RadioButton x:Name="navCore"
                                     GroupName="MainNavigation"
                                     Tag="&#xE9D9;"
                                     Content="运行中心"
                                     ToolTip="Core 进程、自动恢复与诊断"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="NavButton_Checked" />
                        <RadioButton x:Name="navStorage"
                                     GroupName="MainNavigation"
                                     Tag="&#xED25;"
                                     Content="存储空间"
                                     ToolTip="数据目录统计与旧日志清理"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="NavButton_Checked" />
                        <RadioButton x:Name="navSettings"
                                     GroupName="MainNavigation"
                                     Tag="&#xE713;"
                                     Content="系统设置"
                                     ToolTip="系统设置"
                                     Style="{StaticResource NavItemStyle}"
                                     Checked="NavButton_Checked" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Margin="12"
                            Padding="12"
                            Background="{DynamicResource SubtleFillBrush}"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource CoreStatusDotStyle}"
                                     Margin="0,4,10,0"
                                     VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding BoundAddress}"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Page layer -->
            <Border Grid.Column="1"
                    Margin="8,0,8,8"
                    Background="{DynamicResource LayerFillBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource LargeCorner}"
                    ClipToBounds="True">
                <Grid>
                    <views:WorkbenchView x:Name="WorkbenchPage" Visibility="Visible" />
                    <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
                    <views:RuntimeCenterView x:Name="RuntimeCenterPage" Visibility="Collapsed" />
                    <views:StorageView x:Name="StoragePage" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <!-- Compact command/status strip -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource NavigationFillBrush}">
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Padding="10,5"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillBrush}"
                        CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource CoreStatusDotStyle}"
                                 Margin="0,0,7,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="Core: 就绪"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="API"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="AddressText"
                               Text="未绑定"
                               Margin="6,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="14"
                            Margin="14,0"
                            Background="{DynamicResource DividerBrush}" />
                    <TextBlock Text="数据"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DataRoot}"
                               Margin="6,0,0,0"
                               MaxWidth="380"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="StartButton"
                            Content="启动"
                            Margin="4,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="30" MinWidth="66"
                            Click="StartCore_Click" />
                    <Button x:Name="StopButton"
                            Content="停止"
                            Margin="4,0"
                            Style="{StaticResource CompactButtonStyle}"
                            Click="StopCore_Click" />
                    <Button x:Name="RestartButton"
                            Content="重启"
                            Margin="4,0"
                            Style="{StaticResource CompactButtonStyle}"
                            Click="RestartCore_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
