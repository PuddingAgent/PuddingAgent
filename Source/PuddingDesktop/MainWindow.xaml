<Window x:Class="PuddingDesktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource ShellBackground}">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Padding="20,0,150,0">
   <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <Border Width="26" Height="26" CornerRadius="8" Background="#D59F61"><TextBlock Text="P" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#202020"/></Border>
    <TextBlock Text="Pudding" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="你的智能工作台" FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="OnNavigate">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="工作台" Tag="web" Icon="Home" IsSelected="True"/>
    <NavigationViewItem Content="浏览器" Tag="browser" Icon="World"/>
    <NavigationViewItem x:Name="RuntimeNavigationItem" Content="运行中心" Tag="runtime" Icon="Play"/>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem Content="启动设置" Tag="settings" Icon="Setting"/>
   </NavigationView.FooterMenuItems>
   <Grid Margin="0,0,12,8">
    <Grid x:Name="WorkbenchPane"><Grid x:Name="WorkbenchHost"/>
     <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="540">
      <TextBlock Text="准备你的工作台" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock x:Name="LoadingText" Text="正在连接 Pudding Core…" TextWrapping="Wrap" Opacity="0.7"/>
      <Button Content="启动 Core" Click="OnStart"/>
     </StackPanel>
    </Grid>
    <Grid x:Name="RuntimePane" Visibility="Collapsed" Padding="24" RowSpacing="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Spacing="12">
      <TextBlock Text="运行中心" FontSize="28" FontWeight="SemiBold"/>
     </StackPanel>
     <Grid Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
       <StackPanel Spacing="8"><TextBlock Text="Core 状态" Opacity="0.65"/><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon x:Name="RuntimeStateIcon" Symbol="Pause"/><TextBlock x:Name="RuntimeStateText" FontSize="21" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="RuntimePidText" FontSize="12" Opacity="0.7"/></StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
       <StackPanel Spacing="8"><TextBlock Text="CPU · 整机占比" Opacity="0.65"/><TextBlock x:Name="RuntimeCpuText" Text="—" FontSize="24" FontWeight="SemiBold"/><ProgressBar x:Name="RuntimeCpuBar" Minimum="0" Maximum="100" Value="0"/><TextBlock Text="每秒采样 · 仅 Core" FontSize="12" Opacity="0.6"/></StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
       <StackPanel Spacing="8"><TextBlock Text="内存 · 工作集" Opacity="0.65"/><TextBlock x:Name="RuntimeMemoryText" Text="—" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="物理内存 · 仅 Core" FontSize="12" Opacity="0.6"/></StackPanel>
      </Border>
      <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
       <StackPanel Spacing="8"><TextBlock Text="运行时长" Opacity="0.65"/><TextBlock x:Name="RuntimeUptimeText" Text="—" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="RuntimeStartedText" FontSize="12" TextWrapping="Wrap" Opacity="0.7"/></StackPanel>
      </Border>
     </Grid>
     <StackPanel Grid.Row="2" Spacing="10">
      <TextBlock x:Name="RuntimeText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.75"/>
      <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="StartButton" Content="启动" Click="OnStart"/><Button Content="停止" Click="OnStop"/><Button Content="重启" Click="OnRestart"/><Button Content="退出 Pudding" Click="OnExit"/></StackPanel>
     </StackPanel>
     <Grid Grid.Row="3" RowSpacing="10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="Core 日志" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="FollowLogsBox" Content="跟随最新日志" IsChecked="True" HorizontalAlignment="Right"/></Grid>
      <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
       <ScrollViewer x:Name="RuntimeLogScroll" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
      </Border>
     </Grid>
    </Grid>
    <ScrollViewer x:Name="SettingsPane" Visibility="Collapsed" Padding="28">
     <StackPanel Spacing="18" MaxWidth="660" HorizontalAlignment="Left">
      <TextBlock Text="启动设置" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="业务配置在 Web 工作台中管理。这里设置本机启动参数。" TextWrapping="Wrap" Opacity="0.65"/>
      <TextBox x:Name="DataRootBox" Header="数据目录" MinWidth="480"/>
      <TextBox x:Name="CorePathBox" Header="Core 可执行文件（留空使用配套 Core）" PlaceholderText="留空自动启动；自定义路径须包含 PuddingAgent.exe"/>
      <NumberBox x:Name="PortBox" Header="Core 端口" Minimum="1" Maximum="65535" Value="80" SpinButtonPlacementMode="Compact"/>
      <CheckBox x:Name="AutoStartBox" Content="打开 Desktop 时启动 Core" IsChecked="True"/>
      <CheckBox x:Name="TrayBox" Content="关闭窗口时最小化到托盘" IsChecked="True"/>
      <ComboBox x:Name="ThemeBox" Header="外观" SelectedIndex="0" SelectionChanged="OnTheme"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
      <Button Content="保存启动设置" Click="OnSave"/>
      <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="BrowserPane" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="6" Margin="8"><Button Content="新标签" Click="OnNewTab"/><Button Content="后退" Click="OnBack"/><Button Content="刷新" Click="OnReload"/><TextBox x:Name="AddressBox" Width="420" PlaceholderText="输入网址" KeyDown="OnAddressKey"/><Button Content="打开" Click="OnGo"/><Button Content="设为 Agent 目标" Click="OnTarget"/><ToggleButton x:Name="Takeover" Content="人工接管" Click="OnTakeover"/></StackPanel>
     <ListView x:Name="BrowserTabs" Grid.Row="1" SelectionChanged="OnBrowserTab" MaxHeight="100"><ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Title}" MaxWidth="400" TextTrimming="CharacterEllipsis"/><Button Content="关闭" Click="OnCloseTab" Padding="6,1"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
     <Grid x:Name="BrowserSurface" Grid.Row="2"/>
     <TextBlock x:Name="BrowserStatus" Grid.Row="3" Margin="8" TextWrapping="Wrap"/>
    </Grid>
   </Grid>
  </NavigationView>
  <TextBlock x:Name="StatusText" Grid.Row="2" Margin="20,0" FontSize="11" VerticalAlignment="Center" Opacity="0.65"/>
 </Grid>
</Window>
