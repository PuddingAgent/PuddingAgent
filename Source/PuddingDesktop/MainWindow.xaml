<Window x:Class="PuddingDesktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:PuddingDesktop">
 <Grid x:Name="Root" Background="{ThemeResource ShellBackground}">
  <Grid.Resources>
   <!--
    Lightweight styling for the tool workspace (reference: pill tab chips, circular
    toolbar buttons, omnibox pill). Explicit ARGB per theme keeps one visual language
    in light, dark and high contrast without hardcoding a single theme's colours.
   -->
   <ResourceDictionary>
    <ResourceDictionary.ThemeDictionaries>
     <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="ToolTabSelectedBrush" Color="#2EFFFFFF"/>
      <SolidColorBrush x:Key="ToolTabSelectedHoverBrush" Color="#3DFFFFFF"/>
      <SolidColorBrush x:Key="ToolTabHoverBrush" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="ToolTabPressedBrush" Color="#1FFFFFFF"/>
      <SolidColorBrush x:Key="ToolChipFillBrush" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="ToolChipHoverBrush" Color="#24FFFFFF"/>
      <SolidColorBrush x:Key="ToolChipPressedBrush" Color="#0FFFFFFF"/>
      <!-- Chip visuals come from the ListViewItem states, so the chip is one control.
           The selected fill is deliberately strong: the active instance must be obvious. -->
      <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#3DFFFFFF"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#4DFFFFFF"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#2EFFFFFF"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#1FFFFFFF"/>
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
     </ResourceDictionary>
     <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="ToolTabSelectedBrush" Color="#1F000000"/>
      <SolidColorBrush x:Key="ToolTabSelectedHoverBrush" Color="#2E000000"/>
      <SolidColorBrush x:Key="ToolTabHoverBrush" Color="#0F000000"/>
      <SolidColorBrush x:Key="ToolTabPressedBrush" Color="#17000000"/>
      <SolidColorBrush x:Key="ToolChipFillBrush" Color="#0A000000"/>
      <SolidColorBrush x:Key="ToolChipHoverBrush" Color="#14000000"/>
      <SolidColorBrush x:Key="ToolChipPressedBrush" Color="#08000000"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#2E000000"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#3D000000"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#1F000000"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0F000000"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#17000000"/>
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
     </ResourceDictionary>
     <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="ToolTabSelectedBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ToolTabSelectedHoverBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ToolTabHoverBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ToolTabPressedBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ToolChipFillBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ToolChipHoverBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ToolChipPressedBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/>
      <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/>
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
     </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Ghost icon action: tab bar "+", overflow, zoom, collapse.
         Every keyed style must be based on the WinUI default style, otherwise the
         control loses the default setters (corner radius, state brushes) entirely. -->
    <Style x:Key="ToolIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
     <Setter Property="Width" Value="32"/>
     <Setter Property="Height" Value="32"/>
     <Setter Property="MinWidth" Value="0"/>
     <Setter Property="Padding" Value="0"/>
     <Setter Property="Background" Value="Transparent"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Setter Property="CornerRadius" Value="8"/>
     <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
     <Setter Property="FontSize" Value="14"/>
     <Setter Property="HorizontalContentAlignment" Value="Center"/>
     <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Filled circular button used by the current tool's operation bar. -->
    <Style x:Key="ToolRoundButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolIconButtonStyle}">
     <Setter Property="Width" Value="34"/>
     <Setter Property="Height" Value="34"/>
     <Setter Property="CornerRadius" Value="17"/>
     <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
     <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Same shape, but with a label (Agent target / human takeover). -->
    <Style x:Key="ToolRoundTextButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolRoundButtonStyle}">
     <Setter Property="Width" Value="Auto"/>
     <Setter Property="Padding" Value="12,0"/>
     <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}"/>
     <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="ToolRoundToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
     <Setter Property="Height" Value="34"/>
     <Setter Property="MinWidth" Value="0"/>
     <Setter Property="CornerRadius" Value="17"/>
     <Setter Property="Padding" Value="12,0"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
     <Setter Property="FontSize" Value="12"/>
     <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- DropDownButton retains its control-provided default template (including
         chevron/flyout); WinUI does not expose a DefaultDropDownButtonStyle key. -->
    <Style x:Key="ToolIconDropDownStyle" TargetType="DropDownButton">
     <Setter Property="Width" Value="32"/>
     <Setter Property="Height" Value="32"/>
     <Setter Property="MinWidth" Value="0"/>
     <Setter Property="Padding" Value="0"/>
     <Setter Property="Background" Value="Transparent"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Setter Property="CornerRadius" Value="8"/>
     <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
     <Setter Property="FontSize" Value="14"/>
     <Setter Property="HorizontalContentAlignment" Value="Center"/>
     <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ToolRoundDropDownStyle" TargetType="DropDownButton">
     <Setter Property="Width" Value="34"/>
     <Setter Property="Height" Value="34"/>
     <Setter Property="MinWidth" Value="0"/>
     <Setter Property="Padding" Value="0"/>
     <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Setter Property="CornerRadius" Value="17"/>
     <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
     <Setter Property="FontSize" Value="13"/>
     <Setter Property="HorizontalContentAlignment" Value="Center"/>
     <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Pill omnibox. -->
    <Style x:Key="ToolAddressBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
     <Setter Property="Height" Value="34"/>
     <Setter Property="CornerRadius" Value="17"/>
     <Setter Property="BorderThickness" Value="1"/>
     <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
     <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
     <Setter Property="TextAlignment" Value="Center"/>
     <Setter Property="VerticalContentAlignment" Value="Center"/>
     <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Tab chip: one rounded instance per open tool. -->
    <Style x:Key="ToolTabItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
     <Setter Property="MinHeight" Value="0"/>
     <Setter Property="Padding" Value="0"/>
     <Setter Property="Margin" Value="0,0,4,0"/>
     <Setter Property="CornerRadius" Value="9"/>
     <Setter Property="HorizontalContentAlignment" Value="Left"/>
     <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ToolTabCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
     <Setter Property="Width" Value="18"/>
     <Setter Property="Height" Value="18"/>
     <Setter Property="MinWidth" Value="0"/>
     <Setter Property="Padding" Value="0"/>
     <Setter Property="Background" Value="Transparent"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Setter Property="CornerRadius" Value="9"/>
     <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
     <Setter Property="FontSize" Value="8"/>
     <Setter Property="HorizontalContentAlignment" Value="Center"/>
     <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Tool home entry card: one rounded row per way into the workspace. -->
    <Style x:Key="ToolHomeCardStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
     <Setter Property="HorizontalAlignment" Value="Stretch"/>
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="VerticalContentAlignment" Value="Center"/>
     <Setter Property="MinHeight" Value="0"/>
     <Setter Property="Padding" Value="16,12"/>
     <Setter Property="Margin" Value="0,0,0,10"/>
     <Setter Property="CornerRadius" Value="12"/>
     <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
     <Setter Property="BorderThickness" Value="1"/>
     <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    </Style>

    <!-- IMG11：工具首页卡片的可用性标签（可用 / 待接入）。
         文案在启动时由 ToolAvailabilityCatalog 写入（与标签页 Availability 同源），
         不在此处写死 —— 否则「待接入」很容易被画成可用，或反之。 -->
    <Style x:Key="ToolAvailabilityChipStyle" TargetType="Border">
     <Setter Property="CornerRadius" Value="9"/>
     <Setter Property="BorderThickness" Value="1"/>
     <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
     <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
     <Setter Property="Padding" Value="6,1"/>
     <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ToolAvailabilityChipTextStyle" TargetType="TextBlock">
     <Setter Property="FontSize" Value="11"/>
     <Setter Property="Opacity" Value="0.75"/>
    </Style>
   </ResourceDictionary>
  </Grid.Resources>
  <Grid.KeyboardAccelerators>
   <!-- Esc dismisses the overlay form of the tool workspace, never the split form. -->
   <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
   <!-- Shortcuts advertised on the tool home cards. -->
   <KeyboardAccelerator Modifiers="Control" Key="T" Invoked="OnAcceleratorBrowser"/>
   <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnAcceleratorOutput"/>
  </Grid.KeyboardAccelerators>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Padding="20,0,150,0">
   <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <Border Width="26" Height="26" CornerRadius="8" Background="#D59F61"><TextBlock Text="P" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#202020"/></Border>
    <TextBlock Text="Pudding" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="你的智能工作台" FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="OnNavigate">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="工作台" Tag="web" Icon="Home" IsSelected="True"/>
    <NavigationViewItem x:Name="RuntimeNavigationItem" Content="运行中心" Tag="runtime" Icon="Play"/>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem Content="启动设置" Tag="settings" Icon="Setting"/>
   </NavigationView.FooterMenuItems>
   <Grid Margin="0,0,12,8">
    <!-- Workbench page: chat keeps its structure, the tool workspace is added beside it. -->
    <Grid x:Name="WorkbenchPane">
     <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ChatColumn" Width="*"/>
      <ColumnDefinition x:Name="ToolSplitterColumn" Width="0"/>
      <ColumnDefinition x:Name="ToolColumn" Width="0"/>
     </Grid.ColumnDefinitions>
     <Grid x:Name="WorkbenchHost" Grid.Column="0"/>
     <StackPanel x:Name="LoadingPanel" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="540">
      <TextBlock Text="准备你的工作台" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock x:Name="LoadingText" Text="正在连接 Pudding Core…" TextWrapping="Wrap" Opacity="0.7"/>
      <Button Content="启动 Core" Click="OnStart"/>
     </StackPanel>
     <!-- IMG05/§13.3：把分割线的可操作方式说清楚 —— 双击复原「默认分栏」是显式
          动作，不能只靠用户猜（拖动与键盘调整同理）。 -->
     <local:SplitterHandle x:Name="ToolSplitter" Grid.Column="1" Visibility="Collapsed"
       ToolTipService.ToolTip="拖动调整宽度 · 双击恢复默认分栏 · ←/→ 微调"
       PointerPressed="OnSplitterPointerPressed" PointerMoved="OnSplitterPointerMoved"
       PointerReleased="OnSplitterPointerReleased" PointerCaptureLost="OnSplitterPointerCaptureLost"
       PointerEntered="OnSplitterPointerEntered" PointerExited="OnSplitterPointerExited"
       DoubleTapped="OnSplitterDoubleTapped" KeyDown="OnSplitterKeyDown">
      <Rectangle x:Name="ToolSplitterLine" Width="1" HorizontalAlignment="Center" Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
     </local:SplitterHandle>
     <Border x:Name="ToolOverlayScrim" Grid.ColumnSpan="3" Background="#40000000" Visibility="Collapsed" Tapped="OnToolScrimTapped"/>
     <!-- Right tool workspace: instance tabs, per-tool toolbar, content, status. -->
     <Grid x:Name="ToolPanel" Grid.Column="2" Visibility="Collapsed" Background="{ThemeResource ShellBackground}">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Padding="8,6,8,4" ColumnSpacing="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <!-- Left-aligned so "+" sits right after the last chip, like the reference. -->
       <ListView x:Name="ToolTabList" SelectionMode="Single" SelectionChanged="OnToolTabSelected"
         HorizontalAlignment="Left" VerticalAlignment="Center"
         ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
         ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource ToolTabItemStyle}"/></ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
         <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,5">
           <FontIcon Glyph="{Binding Glyph}" FontSize="13" Opacity="0.85" VerticalAlignment="Center"/>
           <TextBlock Text="{Binding Title}" MaxWidth="140" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Tooltip}"/>
           <ProgressRing Width="12" Height="12" IsActive="{Binding IsRunning}" Visibility="{Binding RunningVisibility}" VerticalAlignment="Center"/>
           <Ellipse Width="7" Height="7" Fill="#D59F61" Visibility="{Binding UnreadVisibility}" VerticalAlignment="Center"/>
           <Button Style="{StaticResource ToolTabCloseButtonStyle}" Click="OnCloseToolTab" Visibility="{Binding CloseVisibility}" VerticalAlignment="Center" ToolTipService.ToolTip="关闭标签页">
            <FontIcon Glyph="&#xE711;" FontSize="8"/>
           </Button>
          </StackPanel>
         </DataTemplate>
        </ListView.ItemTemplate>
       </ListView>
       <DropDownButton x:Name="ToolAddButton" Grid.Column="1" Content="&#xE710;" Style="{StaticResource ToolIconDropDownStyle}" ToolTipService.ToolTip="打开工具">
        <DropDownButton.Flyout>
         <MenuFlyout Placement="BottomEdgeAlignedLeft">
          <MenuFlyoutItem Text="新标签页（工具首页）" Click="OnOpenHomeTab"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutItem Text="终端 · 新会话" Click="OnOpenTerminalTab"/>
          <MenuFlyoutItem Text="Agent 浏览器" Click="OnOpenBrowserTab"/>
          <MenuFlyoutItem Text="制成品预览" Click="OnOpenArtifactTab"/>
          <MenuFlyoutItem Text="输出文件" Click="OnOpenOutputTab"/>
          <MenuFlyoutItem Text="交互面板" Click="OnOpenPanelTab"/>
          <MenuFlyoutSeparator/>
          <ToggleMenuFlyoutItem x:Name="AutoExpandMenuItem" Text="任务开始时自动展开" Click="OnToggleAutoExpand"/>
         </MenuFlyout>
        </DropDownButton.Flyout>
       </DropDownButton>
       <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <DropDownButton x:Name="ToolOverflowButton" Content="&#xE70D;" Style="{StaticResource ToolIconDropDownStyle}" Visibility="Collapsed" ToolTipService.ToolTip="全部标签页">
         <DropDownButton.Flyout>
          <MenuFlyout x:Name="ToolOverflowMenu" Placement="BottomEdgeAlignedRight" Opening="OnToolOverflowOpening"/>
         </DropDownButton.Flyout>
        </DropDownButton>
        <Button x:Name="ToolZoomButton" Content="&#xE740;" Style="{StaticResource ToolIconButtonStyle}" Click="OnToggleToolZoom" ToolTipService.ToolTip="放大工具区"/>
        <Button x:Name="ToolCollapseButton" Content="&#xE89F;" Style="{StaticResource ToolIconButtonStyle}" Click="OnCollapseToolPanel" ToolTipService.ToolTip="收起工具区"/>
       </StackPanel>
      </Grid>
      <!-- Operation bar of the active tool; shown for browser tabs only. -->
      <Grid x:Name="BrowserToolBar" Grid.Row="1" Padding="8,6" ColumnSpacing="6" Visibility="Collapsed"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button x:Name="BrowserBackButton" Content="&#xE72B;" Style="{StaticResource ToolRoundButtonStyle}" Click="OnBack" ToolTipService.ToolTip="后退"/>
        <Button x:Name="BrowserForwardButton" Content="&#xE72A;" Style="{StaticResource ToolRoundButtonStyle}" Click="OnForward" ToolTipService.ToolTip="前进"/>
        <Button Content="&#xE72C;" Style="{StaticResource ToolRoundButtonStyle}" Click="OnReload" ToolTipService.ToolTip="刷新"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0">
        <Button Style="{StaticResource ToolRoundTextButtonStyle}" Click="OnTarget" ToolTipService.ToolTip="把当前页面设为 Agent 目标">
         <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE7B3;" FontSize="12"/>
          <TextBlock Text="设为 Agent 目标" VerticalAlignment="Center"/>
         </StackPanel>
        </Button>
        <ToggleButton x:Name="Takeover" Style="{StaticResource ToolRoundToggleStyle}" Click="OnTakeover" ToolTipService.ToolTip="人工接管：暂停 Agent 操作">
         <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE7FC;" FontSize="12"/>
          <TextBlock Text="人工接管" VerticalAlignment="Center"/>
         </StackPanel>
        </ToggleButton>
       </StackPanel>
       <TextBox x:Name="AddressBox" Grid.Column="2" Style="{StaticResource ToolAddressBoxStyle}"
         PlaceholderText="搜索或输入网址" KeyDown="OnAddressKey"/>
       <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Content="&#xE710;" Style="{StaticResource ToolRoundButtonStyle}" Click="OnNewTab" ToolTipService.ToolTip="新建页面"/>
        <DropDownButton Content="&#xE712;" Style="{StaticResource ToolRoundDropDownStyle}" ToolTipService.ToolTip="更多操作">
         <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
           <MenuFlyoutItem Text="打开地址" Click="OnGo"/>
           <MenuFlyoutItem Text="刷新" Click="OnReload"/>
           <MenuFlyoutItem Text="后退" Click="OnBack"/>
           <MenuFlyoutItem Text="前进" Click="OnForward"/>
           <MenuFlyoutItem Text="新建页面" Click="OnNewTab"/>
           <MenuFlyoutSeparator/>
           <MenuFlyoutItem Text="将当前地址复制到剪贴板" Click="OnCopyAddress"/>
           <MenuFlyoutItem Text="在系统浏览器中打开" Click="OnOpenAddressExternally"/>
          </MenuFlyout>
         </DropDownButton.Flyout>
        </DropDownButton>
       </StackPanel>
      </Grid>
      <Grid x:Name="ToolContentHost" Grid.Row="2">
       <Grid x:Name="ToolTabContentHost">
        <!--
         Tool home (declared here so the visual design lives in markup): a decorative
         compass over one rounded card per way into the workspace. Created in the tree
         already, so the Shell never re-parents it.
        -->
        <Grid x:Name="ToolHomePanel" Visibility="Collapsed" Padding="24,16">
         <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Spacing="0">
          <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,22" Opacity="0.45">
           <Ellipse Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="2"/>
           <Path Data="M36,13 L45,36 L36,59 L27,36 Z" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><RotateTransform Angle="35"/></Path.RenderTransform>
           </Path>
          </Grid>

          <Button Style="{StaticResource ToolHomeCardStyle}" Click="OnOpenOutputTab" ToolTipService.ToolTip="Ctrl + O">
           <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="#E2A33C" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Spacing="2">
             <TextBlock Text="输出文件" FontSize="15" FontWeight="SemiBold"/>
             <TextBlock Text="打开并预览本机的文档、数据或日志" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
             <Border Style="{StaticResource ToolAvailabilityChipStyle}">
              <TextBlock x:Name="OutputCardAvailabilityText" Style="{StaticResource ToolAvailabilityChipTextStyle}"/>
             </Border>
             <TextBlock Text="Ctrl + O" FontSize="12" Opacity="0.55" HorizontalAlignment="Right"/>
            </StackPanel>
           </Grid>
          </Button>

          <Button Style="{StaticResource ToolHomeCardStyle}" Click="OnOpenTerminalTab">
           <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE756;" FontSize="18" Foreground="#4C8DF6" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Spacing="2">
             <TextBlock Text="新建终端" FontSize="15" FontWeight="SemiBold"/>
             <TextBlock Text="在会话工作区运行命令（会话组件尚未接入）" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource ToolAvailabilityChipStyle}">
             <TextBlock x:Name="TerminalCardAvailabilityText" Style="{StaticResource ToolAvailabilityChipTextStyle}"/>
            </Border>
           </Grid>
          </Button>

          <Button Style="{StaticResource ToolHomeCardStyle}" Click="OnOpenBrowserTab" ToolTipService.ToolTip="Ctrl + T">
           <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="#4C8DF6" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Spacing="2">
             <TextBlock Text="浏览器" FontSize="15" FontWeight="SemiBold"/>
             <TextBlock Text="浏览网页，并指定 Agent 目标页面" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
             <Border Style="{StaticResource ToolAvailabilityChipStyle}">
              <TextBlock x:Name="BrowserCardAvailabilityText" Style="{StaticResource ToolAvailabilityChipTextStyle}"/>
             </Border>
             <TextBlock Text="Ctrl + T" FontSize="12" Opacity="0.55" HorizontalAlignment="Right"/>
            </StackPanel>
           </Grid>
          </Button>

          <Button Style="{StaticResource ToolHomeCardStyle}" Click="OnOpenArtifactTab">
           <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="#B07CD6" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Spacing="2">
             <TextBlock Text="制成品" FontSize="15" FontWeight="SemiBold"/>
             <TextBlock Text="预览 Agent 生成的文档、图表与网页（等待 Core 成果接口）" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource ToolAvailabilityChipStyle}">
             <TextBlock x:Name="ArtifactCardAvailabilityText" Style="{StaticResource ToolAvailabilityChipTextStyle}"/>
            </Border>
           </Grid>
          </Button>

          <Button Style="{StaticResource ToolHomeCardStyle}" Click="OnOpenPanelTab">
           <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="#4CB782" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Spacing="2">
             <TextBlock Text="交互面板" FontSize="15" FontWeight="SemiBold"/>
             <TextBlock Text="Agent 生成的表单、筛选器与参数设置（等待接入）" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource ToolAvailabilityChipStyle}">
             <TextBlock x:Name="PanelCardAvailabilityText" Style="{StaticResource ToolAvailabilityChipTextStyle}"/>
            </Border>
           </Grid>
          </Button>
         </StackPanel>
        </Grid>
       </Grid>
       <!-- One persistent browser surface host: tabs never reparent a live WebView2. -->
       <Grid x:Name="BrowserSurfaceHostPanel" Visibility="Collapsed"/>
       <TextBlock x:Name="ToolEmptyState" Margin="24" TextWrapping="Wrap" Opacity="0.6" VerticalAlignment="Top"
         Text="工具区已打开。用右上角 + 打开终端、Agent 浏览器、制成品、输出文件或交互面板。"/>
      </Grid>
      <TextBlock x:Name="ToolStatusText" Grid.Row="3" Margin="8,4" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
     </Grid>
     <Button x:Name="ToolEntryButton" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Visibility="Collapsed" Click="OnExpandToolPanel" ToolTipService.ToolTip="打开工具区"/>
    </Grid>
    <Grid x:Name="RuntimePane" Visibility="Collapsed" Padding="24" RowSpacing="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Spacing="12">
      <TextBlock Text="运行中心" FontSize="28" FontWeight="SemiBold"/>
     </StackPanel>
     <Grid Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
       <StackPanel Spacing="8"><TextBlock Text="Core 状态" Opacity="0.65"/><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon x:Name="RuntimeStateIcon" Symbol="Pause"/><TextBlock x:Name="RuntimeStateText" FontSize="21" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="RuntimePidText" FontSize="12" Opacity="0.7"/></StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
       <StackPanel Spacing="8"><TextBlock Text="CPU · 整机占比" Opacity="0.65"/><TextBlock x:Name="RuntimeCpuText" Text="—" FontSize="24" FontWeight="SemiBold"/><ProgressBar x:Name="RuntimeCpuBar" Minimum="0" Maximum="100" Value="0"/><TextBlock Text="每秒采样 · 仅 Core" FontSize="12" Opacity="0.6"/></StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
       <StackPanel Spacing="8"><TextBlock Text="内存 · 工作集" Opacity="0.65"/><TextBlock x:Name="RuntimeMemoryText" Text="—" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="物理内存 · 仅 Core" FontSize="12" Opacity="0.6"/></StackPanel>
      </Border>
      <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
       <StackPanel Spacing="8"><TextBlock Text="运行时长" Opacity="0.65"/><TextBlock x:Name="RuntimeUptimeText" Text="—" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="RuntimeStartedText" FontSize="12" TextWrapping="Wrap" Opacity="0.7"/></StackPanel>
      </Border>
     </Grid>
     <StackPanel Grid.Row="2" Spacing="10">
      <TextBlock x:Name="RuntimeText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.75"/>
      <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="StartButton" Content="启动" Click="OnStart"/><Button Content="停止" Click="OnStop"/><Button Content="重启" Click="OnRestart"/><Button Content="退出 Pudding" Click="OnExit"/></StackPanel>
     </StackPanel>
     <Grid Grid.Row="3" RowSpacing="10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="Core 日志" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="FollowLogsBox" Content="跟随最新日志" IsChecked="True" HorizontalAlignment="Right"/></Grid>
      <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
       <ScrollViewer x:Name="RuntimeLogScroll" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
      </Border>
     </Grid>
    </Grid>
    <ScrollViewer x:Name="SettingsPane" Visibility="Collapsed" Padding="28">
     <StackPanel Spacing="18" MaxWidth="660" HorizontalAlignment="Left">
      <TextBlock Text="启动设置" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="业务配置在 Web 工作台中管理。这里设置本机启动参数。" TextWrapping="Wrap" Opacity="0.65"/>
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="DataRootBox" Header="数据目录" MinWidth="480"/>
       <Button Grid.Column="1" x:Name="DataRootBrowseButton" Content="浏览…" VerticalAlignment="Bottom" Click="OnBrowseDataRoot"/>
      </Grid>
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="CorePathBox" Header="Core 可执行文件（留空使用配套 Core）" PlaceholderText="留空自动启动；自定义路径须包含 PuddingAgent.exe"/>
       <Button Grid.Column="1" x:Name="CorePathBrowseButton" Content="浏览…" VerticalAlignment="Bottom" Click="OnBrowseCorePath"/>
      </Grid>
      <NumberBox x:Name="PortBox" Header="Core 端口" Minimum="1" Maximum="65535" Value="80" SpinButtonPlacementMode="Compact"/>
      <CheckBox x:Name="AutoStartBox" Content="打开 Desktop 时启动 Core" IsChecked="True"/>
      <CheckBox x:Name="TrayBox" Content="关闭窗口时最小化到托盘" IsChecked="True"/>
      <ComboBox x:Name="ThemeBox" Header="外观" SelectedIndex="0" SelectionChanged="OnTheme"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
      <!-- §13.x：两个外观开关并存时，范围必须能一眼分清。这里说明 Shell 侧管什么、
           Web 侧另有开关；对应 Web 顶栏那个按钮已标明"仅 Web 工作台"。 -->
      <TextBlock Text="影响窗口、工具区与底部状态条。Web 工作台（聊天页）顶部另有独立的外观开关，只改 Web。" TextWrapping="Wrap" FontSize="11" Opacity="0.6"/>
      <Button Content="保存启动设置" Click="OnSave"/>
      <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </NavigationView>
  <TextBlock x:Name="StatusText" Grid.Row="2" Margin="20,0" FontSize="11" VerticalAlignment="Center" Opacity="0.65"/>
 </Grid>
</Window>
