<Project Sdk="MSTest.Sdk/4.0.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <!-- Component tests for PuddingPathFiltering (组件化交付规程 S2/S3).
       Boundary rule: this test project MUST reference PuddingPathFiltering ONLY.
       It must never reference PuddingCodeIndex / PuddingRuntime / PuddingHost / PuddingAgent,
       so the filter can be built and tested without the running host (规程 R1).
       The boundary is asserted at runtime by ComponentBoundaryTests. -->
  <ItemGroup>
    <ProjectReference Include="..\PuddingPathFiltering\PuddingPathFiltering.csproj" />
  </ItemGroup>

  <!-- Frozen `git check-ignore` oracle: pattern sources + per-path verdicts. -->
  <ItemGroup>
    <None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
