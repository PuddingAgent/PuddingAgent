<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup><ProjectReference Include="../Pudding.Api.Contracts/Pudding.Api.Contracts.csproj" /></ItemGroup>
  <Target Name="EnforceWorkPortsBoundary" BeforeTargets="ResolveProjectReferences">
    <Error Condition="'%(ProjectReference.Filename)' != 'Pudding.Api.Contracts'" Text="Work ports may only reference public API contracts." />
    <Error Condition="'@(PackageReference)' != ''" Text="Work ports must remain BCL-only." />
    <Error Condition="'%(FrameworkReference.Identity)' != '' And '%(FrameworkReference.Identity)' != 'Microsoft.NETCore.App'" Text="Only the base runtime framework is allowed." />
  </Target>
</Project>
