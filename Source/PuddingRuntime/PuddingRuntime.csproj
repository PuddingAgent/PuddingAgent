<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <IsPublishable>false</IsPublishable>
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
    </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PuddingRuntimeTests" />
    <InternalsVisibleTo Include="PuddingCodeIntelligenceTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Flurl.Http" Version="4.0.2" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="NAudio.Core" Version="2.3.0" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="Microsoft.Build.Tasks.Git" Version="10.0.401" PrivateAssets="all" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
        <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="ReverseMarkdown" Version="5.3.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuddingCodeIntelligence\PuddingCodeIntelligence.csproj" />
    <ProjectReference Include="..\PuddingCodeIndex\PuddingCodeIndex.csproj" />
    <ProjectReference Include="..\PuddingFullTextIndex\PuddingFullTextIndex.csproj" />
    <!-- ADR-089 U4-4 D4: tool-side exclusion lists are derived from this leaf. -->
    <ProjectReference Include="..\PuddingPathFiltering\PuddingPathFiltering.csproj" />
    <!-- LLM 余额采样：消耗判定是零依赖叶子，Runtime 只是它的宿主侧适配器（端口 + HTTP 实现）。 -->
    <ProjectReference Include="..\PuddingLlmUsage\PuddingLlmUsage.csproj" />
    <!-- 采样适配器：Runtime 在组合根里直接构造 SqliteLlmUsageStore（与既有的
         new SqliteCodeIndexStore 一致）；叶子与适配器分开，判定逻辑仍零依赖。 -->
    <ProjectReference Include="..\PuddingLlmUsage.Storage\PuddingLlmUsage.Storage.csproj" />
    <!-- S5：上下文容量/候选/收益/退避纯策略组件（BCL-only 叶子，无反向依赖）；Runtime 在提交边界消费。 -->
    <ProjectReference Include="..\PuddingContextPolicy\PuddingContextPolicy.csproj" />
    <!-- S5：零 LLM 确定性载荷剪枝（只依赖 PuddingCore 的叶子）；Runtime 在发请求边界消费。 -->
    <ProjectReference Include="..\PuddingContextPruning\PuddingContextPruning.csproj" />
  </ItemGroup>

  <ItemGroup>
        <ProjectReference Include="..\PuddingCore\PuddingCore.csproj" />
    <ProjectReference Include="..\PuddingMemoryEngine\PuddingMemoryEngine.csproj" />
    <!-- 可诊断基础设施叶子组件：失败因果分类 / 有界证据 / 事故投影 / 呈现与复制载荷。 -->
    <ProjectReference Include="..\PuddingDiagnostics\PuddingDiagnostics.csproj" />
    <!-- S5：必盈金融数据源叶子组件（ProjectReference=0）；Runtime 负责配置读取、客户端单例与工具接入。 -->
    <ProjectReference Include="..\PuddingFinance\PuddingFinance.csproj" />
    <!-- S5：HTML 正文抽取 + Markdown 转换叶子组件（ProjectReference=0）。
         PuddingRuntime（http_fetch）与 PuddingBrowser.AgentTools（snapshot text 模式）
         都指向它，而它不指向任何一方 —— 这是唯一不会造成反向依赖的方向。 -->
    <ProjectReference Include="..\PuddingHtml\PuddingHtml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- S5：DeepSeek Search/Fetch 协议组件（叶子，ProjectReference=0、无反向依赖）；Runtime 提供 IWebClient 传输适配 + 工具体系接入。 -->
    <ProjectReference Include="..\PuddingDeepSeekWeb\PuddingDeepSeekWeb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="runtimes\win-x64\native\Everything64.dll" CopyToOutputDirectory="Always">
      <TargetPath>Everything64.dll</TargetPath>
    </None>
  </ItemGroup>

</Project>
