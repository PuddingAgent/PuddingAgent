<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup><ProjectReference Include="../Pudding.Api.Contracts/Pudding.Api.Contracts.csproj" /></ItemGroup>
  <Target Name="EnforceOperatorPortsBoundary" BeforeTargets="ResolveProjectReferences">
    <Error Condition="'%(ProjectReference.Filename)' != 'Pudding.Api.Contracts' Or '@(PackageReference)' != ''" Text="Operator ports may only reference public contracts." />
    <Error Condition="'%(FrameworkReference.Identity)' != '' And '%(FrameworkReference.Identity)' != 'Microsoft.NETCore.App'" Text="Only the base runtime framework is allowed." />
  </Target>
</Project>
