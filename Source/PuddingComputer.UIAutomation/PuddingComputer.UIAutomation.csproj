<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PuddingComputer.UIAutomation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pudding.Contracts\Pudding.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 5.0.0 已在 .NET 10 上验证可用（`temp``/uia-probe` 实探过计算器与记事本）。 -->
    <PackageReference Include="FlaUI.UIA2" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <!--
    Computer Use 的**无障碍发现**层（规程 S1）。

    定位：路由栈的第一跳。Codex 两轮规划的核心论断是
    「不要把通用视觉分割当成主控制面」—— 原生 Win32 / WinUI 应用里，
    UIA 能直接给出控件类型、名称、包围盒、可用状态，比任何像素方法都可靠。

    本工程只做**只读观察**：
      附加已确认的顶层窗口 → 有界枚举子树 → 归一化成契约记录 → 报告可用性
    不点击、不输入、不排序、不重试、不验证结果。那些属于后续层。

    **边界（S4 由 BoundaryTests 强制）**：
      允许引用 Pudding.Contracts + FlaUI
      禁止引用 PuddingComputer.Windows（截图/输入/OpenCV）、
           PuddingComputer.Benchmark、PuddingComputer.Automation、宿主相关程序集

    契约与可用性分类集中在这里，**不放进 Pudding.Contracts** ——
    后者是跨层共享物，S1 阶段先把边界收紧，S5 再决定要不要上移。
  -->

</Project>
