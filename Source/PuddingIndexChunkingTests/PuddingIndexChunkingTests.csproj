<Project Sdk="MSTest.Sdk/4.0.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <!-- Component tests for PuddingIndexChunking (组件化交付规程 S2/S3).

       Boundary rule: this test project MUST reference PuddingIndexChunking ONLY — no Roslyn/MSBuild,
       no PuddingCodeIntelligence / PuddingRuntime / PuddingHost / PuddingAgent / PuddingCodeIndex /
       PuddingRetrievalEval. That is what makes the chunking rules testable as a component instead of
       as a probe script, and it is asserted at runtime by ComponentBoundaryTests (which also re-reads
       this project's sibling csproj so the manifest itself cannot drift). -->
  <ItemGroup>
    <ProjectReference Include="..\PuddingIndexChunking\PuddingIndexChunking.csproj" />
  </ItemGroup>

</Project>
