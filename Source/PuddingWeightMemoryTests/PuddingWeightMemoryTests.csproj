<Project Sdk="MSTest.Sdk/4.0.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
    <RootNamespace>PuddingWeightMemoryTests</RootNamespace>
  </PropertyGroup>

  <!--
    PuddingWeightMemory 的组件测试（组件化交付规程 S2）。

    边界：本项目只声明对 PuddingWeightMemory 一个 ProjectReference。编码器由确定性替身驱动
    （按文本查固定向量，无随机、无模型），每个测试用一个独立的临时库文件，因此
    "点积排序 / 阈值 / 四步梯度 / 快照比较交换 / 事务回滚" 全部可以在没有宿主、没有 Python
    编码进程的情况下被断言。边界本身由 ComponentBoundaryTests 在运行时复核（含读回两个 csproj）。
  -->
  <ItemGroup>
    <ProjectReference Include="..\PuddingWeightMemory\PuddingWeightMemory.csproj" />
  </ItemGroup>

</Project>
