<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup><ProjectReference Include="../Pudding.Api.Contracts/Pudding.Api.Contracts.csproj" /></ItemGroup>
  <Target Name="EnforceConfigurationPortBoundary" BeforeTargets="ResolveProjectReferences">
    <Error Condition="'%(ProjectReference.Filename)' != 'Pudding.Api.Contracts'" Text="Configuration ports may only reference public value contracts." />
    <Error Condition="'@(PackageReference)' != ''" Text="Configuration ports must be BCL-only." />
    <Error Condition="'%(FrameworkReference.Identity)' != '' And '%(FrameworkReference.Identity)' != 'Microsoft.NETCore.App'" Text="Only the base runtime framework is allowed." />
  </Target>
</Project>
