{
  "display_information": {
    "name": "PuddingAgent",
    "description": "Chat with your local PuddingAgent through DMs and mentions."
  },
  "features": {
    "bot_user": { "display_name": "PuddingAgent", "always_online": false },
    "app_home": { "home_tab_enabled": false, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false }
  },
  "oauth_config": {
    "scopes": { "bot": ["app_mentions:read", "im:history", "chat:write", "users:read"] }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention", "message.im"] },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
